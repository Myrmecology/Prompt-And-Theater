# ============================================================
# PROMPT AND THEATER — .gitignore
# Security-rich, YubiKey aware
# ============================================================

# --- Environment & Secrets ---
.env
.env.*
*.env
.env.local
.env.development
.env.production
.env.staging
secrets/
secret.json
secrets.json
config/secrets.*

# --- API Keys & Credentials ---
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
api_keys.txt
credentials.json
token.json
auth.json

# --- YubiKey & Hardware Security ---
*.yubikey
yubikey.conf
yubikey_config/
.yubico/
ykpers/
yubikey-manager/
*.slot
gpg-agent.conf
sshcontrol
private-keys-v1.d/
*.gpg
*.asc
secring.gpg
pubring.gpg
trustdb.gpg
.gnupg/

# --- SSH Keys ---
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
known_hosts
authorized_keys
.ssh/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
.virtualenv/
Pipfile.lock

# --- FastAPI / Uvicorn ---
.uvicorn/
uvicorn.log

# --- Database & Session ---
*.db
*.sqlite
*.sqlite3
sessions/
session_data/
*.session

# --- Logs ---
*.log
logs/
log/
*.out
*.err

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- VS Code ---
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.vscode/*.code-snippets
.history/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Node (if any frontend tooling is added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Jupyter (just in case) ---
.ipynb_checkpoints/
*.ipynb

# --- Misc ---
*.bak
*.swp
*.swo
*.tmp
*.temp
.cache/
.mypy_cache/
.dmypy.json
dmypy.json