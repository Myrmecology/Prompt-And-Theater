# ============================================================
# PROMPT & THEATER — .gitignore
# Comprehensive Security-Rich Ignore File
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so
.eggs/

# --- Virtual Environments ---
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/
.venv/

# --- Environment Variables & Secrets ---
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.env
secrets.py
secrets.json
config/secrets/
credentials.json
credentials.yaml
credentials.yml
*_credentials.*
*_secret.*
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.csr
*.der
*.priv
private_key*
public_key*
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.gpg
*.pgp
*.asc

# --- YubiKey & Hardware Security Keys ---
*.yubikey
yubikey_config*
yubikey_secrets*
yubi_*
*.ykman
ykman_config*
.yubico/
yubico_config*
u2f_keys*
fido_*
*.fido
piv_*
*.slot
otp_secrets*
totp_secrets*
hotp_secrets*
yubikey_oath*
*.oath
challenge_response*
*.cr

# --- SSH & Keys ---
.ssh/
ssh_config
known_hosts
authorized_keys
*.ppk
*.openssh

# --- Database ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
instance/

# --- Logs ---
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- VS Code ---
.vscode/
*.code-workspace
.history/

# --- IDEs ---
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Node / NPM (if ever used) ---
node_modules/
package-lock.json
yarn.lock
.npm/
.yarn/

# --- Flask Specific ---
instance/
.webassets-cache
flask_session/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Temporary Files ---
*.tmp
*.temp
*.bak
*.backup
*.orig
*.cache
.cache/
tmp/
temp/

# --- User Data & Tickets (local only) ---
data/tickets/saved_tickets.json

# --- API Keys (extra safety net) ---
api_keys*
api_key*
*_api_key*
*_api_token*
token.json
tokens.json
auth_token*
bearer_token*
access_token*

# --- Compiled Assets ---
*.min.js.map
*.min.css.map